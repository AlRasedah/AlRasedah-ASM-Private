[Unit]
Description=Exteriq ASM core worker (scan orchestration, reports, feeds, notifications, exports)
PartOf=exteriq.target
After=network.target postgresql.service exteriq-valkey.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=exteriq
Group=exteriq
EnvironmentFile=/etc/exteriq/exteriq.env
Environment=ASM_SERVICE=worker EXTERIQ_NATIVE=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/exteriq
WorkingDirectory=/var/lib/exteriq
SyslogIdentifier=exteriq-worker
Restart=on-failure
RestartSec=5
# The platform account never needs scanner keys, TLS keys or backups.
InaccessiblePaths=-/etc/exteriq/scanner -/etc/exteriq/tls -/var/lib/exteriq/backups -/var/lib/exteriq/valkey
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A refused call fails with EPERM (the program can report it) instead of killing the process.
SystemCallErrorNumber=EPERM
SystemCallFilter=~@privileged @resources
UMask=0027
ExecStart=/opt/exteriq/current/platform/venv/bin/celery -A app.workers.celery_app worker -Q core \
    --concurrency ${ASM_CORE_CONCURRENCY} --loglevel ${ASM_LOG_LEVEL} --max-tasks-per-child 200 \
    --hostname worker@%H
ReadWritePaths=/var/lib/exteriq/storage /var/lib/exteriq/exports
# Egress: vulnerability feeds, webhooks, SIEM integrations, e-mail.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Warm shutdown: SIGTERM to the main process only, which lets running tasks finish.
KillMode=mixed
TimeoutStopSec=300
MemoryMax=2G
CPUQuota=200%
TasksMax=256
# Alert and audit exports can burst; drops by journald are reported in the journal.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50000

[Install]
WantedBy=exteriq.target
