[Unit]
Description=Exteriq ASM scheduler (periodic tasks)
PartOf=exteriq.target
After=postgresql.service exteriq-valkey.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=exteriq
Group=exteriq
EnvironmentFile=/etc/exteriq/exteriq.env
Environment=ASM_SERVICE=scheduler EXTERIQ_NATIVE=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/exteriq
WorkingDirectory=/var/lib/exteriq
SyslogIdentifier=exteriq-scheduler
Restart=on-failure
RestartSec=5
# The platform account never needs scanner keys, TLS keys or backups.
InaccessiblePaths=-/etc/exteriq/scanner -/etc/exteriq/tls -/var/lib/exteriq/backups -/var/lib/exteriq/valkey
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A refused call fails with EPERM (the program can report it) instead of killing the process.
SystemCallErrorNumber=EPERM
SystemCallFilter=~@privileged @resources
UMask=0027
StateDirectory=exteriq/scheduler
StateDirectoryMode=0750
ExecStart=/opt/exteriq/current/platform/venv/bin/celery -A app.workers.celery_app beat \
    --loglevel ${ASM_LOG_LEVEL} --schedule /var/lib/exteriq/scheduler/celerybeat-schedule
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TimeoutStopSec=30
MemoryMax=256M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=exteriq.target
