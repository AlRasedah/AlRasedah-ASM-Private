# Exteriq's own message broker instance. It does not use or change the distribution's
# valkey-server.service (which may serve something else on this host): separate port
# (127.0.0.1:6380), config, data directory and account. Broker ACLs in
# /etc/exteriq/valkey-users.acl are the boundary between the platform and each scanner pool.
[Unit]
Description=Exteriq ASM message broker (Valkey)
PartOf=exteriq.target
After=network.target

[Service]
Type=notify
User=exteriq-valkey
Group=exteriq-valkey
ExecStart=/usr/bin/valkey-server /etc/exteriq/valkey.conf --supervised systemd --daemonize no
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
LimitNOFILE=10032
SyslogIdentifier=exteriq-valkey
UMask=0077
ReadWritePaths=/var/lib/exteriq/valkey
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A refused call fails with EPERM (the program can report it) instead of killing the process.
SystemCallErrorNumber=EPERM
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=exteriq.target
