# managed-by: exteriqctl — regenerated by `exteriqctl install` and `exteriqctl tls`.
# Local edits are overwritten; put site-wide additions in a separate file.
#
# TLS terminates here. The API listens on 127.0.0.1:8000 only; the web app is static files
# from the active release.

limit_req_zone $binary_remote_addr zone=exteriq_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=exteriq_api:10m rate=40r/s;

# Path without the query string: one-time tokens in links (password reset) never reach
# the access log.
log_format exteriq '$remote_addr - [$time_iso8601] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent $request_time "$http_user_agent"';

upstream exteriq_api { server 127.0.0.1:8000; keepalive 16; }

server {
    listen @HTTP_PORT@;
    listen [::]:@HTTP_PORT@;
    server_name @SERVER_NAME@;
    server_tokens off;
    access_log /var/log/nginx/exteriq-access.log exteriq;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$host@HTTPS_SUFFIX@$request_uri; }
}

server {
    listen @HTTPS_PORT@ ssl;
    listen [::]:@HTTPS_PORT@ ssl;
    http2 on;
    server_name @SERVER_NAME@;
    server_tokens off;
    client_max_body_size 5m;
    access_log /var/log/nginx/exteriq-access.log exteriq;
    error_log /var/log/nginx/exteriq-error.log warn;

    ssl_certificate     /etc/exteriq/tls/tls.crt;
    ssl_certificate_key /etc/exteriq/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:EXTERIQTLS:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 120s;

    location /api/v1/auth/ {
        limit_req zone=exteriq_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://exteriq_api;
    }
    location /api/ {
        limit_req zone=exteriq_api burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://exteriq_api;
    }

    root /opt/exteriq/current/web;
    location /assets/ {
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        expires 1y;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri /index.html;
    }
}
