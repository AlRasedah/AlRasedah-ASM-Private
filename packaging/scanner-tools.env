# Scanner engine versions for the native package. Keep in step with docker/scanner/Dockerfile.
# The Go toolchain is pinned too: `go` downloads exactly this release (checksum-verified by the
# Go module mirror) whatever version is installed on the build host.
GO_TOOLCHAIN=go1.23.12
SUBFINDER_VERSION=v2.6.6
DNSX_VERSION=v1.2.1
HTTPX_VERSION=v1.6.8
NAABU_VERSION=v2.3.1
NUCLEI_VERSION=v3.3.2
AMASS_VERSION=v4.2.0
