# Exteriq ASM configuration. Copy to .env and generate secrets:
#   python scripts/generate_env.py        (or: sh scripts/generate-env.sh)
# Values containing CHANGE_ME are refused when ASM_ENV=production.

# --- general -----------------------------------------------------------
ASM_ENV=production
ASM_PUBLIC_URL=http://localhost:8080
ASM_DATA_REGION=sa-central
ASM_LOG_LEVEL=INFO
ASM_HTTP_PORT=8080
ASM_HTTPS_PORT=8443
# Set to "true" only when serving over HTTPS (TLS proxy or an external load balancer).
ASM_COOKIE_SECURE=false
# ASM_PROXY_CONF=./docker/proxy/nginx-tls.conf

# --- secrets (generated) --------------------------------------------------
ASM_SECRET_KEY=CHANGE_ME
ASM_ENCRYPTION_KEYS=CHANGE_ME
ASM_SCANNER_TRANSPORT_KEY=CHANGE_ME
ASM_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ASM_DB_PASSWORD=CHANGE_ME
ASM_REDIS_PASSWORD=CHANGE_ME

# --- database ------------------------------------------------------------
ASM_DB_USER=asm
ASM_DB_NAME=asm

# --- first administrator (created on first start, then ignored) -----------
ASM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ASM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
ASM_BOOTSTRAP_TENANT_NAME=Default

# --- email (password resets and email notifications) ----------------------
# ASM_SMTP_HOST=smtp.example.com
# ASM_SMTP_PORT=587
# ASM_SMTP_USERNAME=
# ASM_SMTP_PASSWORD=
# ASM_SMTP_FROM=Exteriq ASM <asm@example.com>
# ASM_SMTP_STARTTLS=true

# --- object storage (default: local volume) -------------------------------
ASM_STORAGE_BACKEND=local
# ASM_STORAGE_BACKEND=s3
# ASM_S3_ENDPOINT_URL=http://minio:9000        # any S3-compatible store (MinIO, OCI, Ceph)
# ASM_S3_BUCKET=asm
# ASM_S3_ACCESS_KEY=
# ASM_S3_SECRET_KEY=

# --- scanning -------------------------------------------------------------
ASM_MAX_CONCURRENT_SCANS_GLOBAL=10
ASM_SCANNER_MAX_RATE=2000
ASM_SENSOR_CONCURRENCY=2
ASM_SENSOR_REPLICAS=1
ASM_SENSOR_QUEUES=scanners.default
ASM_NUCLEI_AUTO_UPDATE=true
ASM_INSTALL_BBOT=false
# Optional OSINT enrichment (start with: docker compose --profile osint up -d)
# ASM_SPIDERFOOT_URL=http://spiderfoot:5001
# Optional DAST engine — OWASP ZAP (start with: docker compose --profile dast up -d).
# Generate a random key and use the SAME value in both variables.
# ASM_ZAP_URL=http://zap:8090
# ASM_ZAP_API_KEY=change-me-to-a-random-key

# --- integrations -----------------------------------------------------------
# false = webhooks may only target public addresses (recommended for SaaS)
ASM_ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# --- vulnerability intelligence (free/public feeds; point to mirrors if air-gapped)
ASM_INTEL_REFRESH_ENABLED=true
# ASM_INTEL_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# ASM_INTEL_EPSS_API_URL=https://api.first.org/data/v1/epss
